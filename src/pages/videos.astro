---
/**
 * Vídeos (design-system §6.2).
 *
 * No filters, no tabs, no "Shorts only" toggle — all of those need JS and none
 * of them earn their keep below ~50 videos. Newest first, always.
 */
import Page from '../layouts/Page.astro';
import VideoList from '../components/VideoList.astro';
import { videos as publicados } from '../lib/videos';

const videos = publicados
	.slice()
	.sort((a, b) => new Date(b.published).valueOf() - new Date(a.published).valueOf());

const contagem = videos.length === 1 ? '1 vídeo' : `${videos.length} vídeos`;
---

<Page
	title="Vídeos"
	description="Todos os vídeos do canal SudoRider, do mais recente para o mais antigo."
	lead="Todos os vídeos do canal, do mais recente para o mais antigo."
	count={videos.length > 0 ? contagem : undefined}
>
	<VideoList videos={videos} headingLevel={2} />
</Page>
