---
/**
 * Static build-time map teaser for the homepage (design-system §6.1).
 *
 * Deliberately not a live map. Leaflet plus tiles is 40KB+ of JS and a burst
 * of tile requests, on the one page with a three-second budget, for a map
 * nobody asked to see. This is ~2KB of theme-aware SVG and zero JS.
 *
 * Simplified mainland Portugal, projected equirectangularly with the same
 * transform used for the pins, so the two stay in register for free:
 *   x = (lon + 9.55) · 77.09      lon −9.55…−6.15
 *   y = (42.2 − lat) · 100        lat  36.9…42.2
 * (mean-latitude scale cos 39.55° = 0.7709, giving a 262 × 530 viewBox)
 *
 * Decorative: aria-hidden, with the surrounding text carrying the meaning.
 */
import type { Local } from '../lib/types';

interface Props {
	locais: Local[];
}

const { locais } = Astro.props;

const OUTLINE =
	'M 51.7 33 L 77.1 17 L 102.5 7 L 112.6 22 L 127.2 28 L 150.3 33 L 181.2 33 L 200.4 25 ' +
	'L 231.3 54 L 259 62 L 231.3 96 L 208.1 118 L 212 165 L 206.6 194 L 195 205 L 205.8 220 ' +
	'L 198.1 254 L 171.9 254 L 155 252 L 171.9 272 L 187.3 285 L 185 325 L 195 333 L 188.9 360 ' +
	'L 175 375 L 188.9 400 L 201.2 407 L 177.3 425 L 162.7 465 L 164.2 492 L 165.7 503 ' +
	'L 127.2 520 L 104.1 511 L 73.2 511 L 50.1 518 L 43.2 521 L 47 480 L 57.8 435 L 51.7 415 ' +
	'L 57.8 378 L 42.4 375 L 26.2 378 L 32.4 354 L 10 350 L 5.4 341 L 17 315 L 10 284 ' +
	'L 38.5 260 L 52.4 205 L 61.7 156 L 67.1 105 L 59.4 65 Z';

const pins = locais
	.map((local) => ({
		x: Math.round((local.lng + 9.55) * 77.09 * 10) / 10,
		y: Math.round((42.2 - local.lat) * 100 * 10) / 10,
	}))
	.filter((pin) => pin.x >= 0 && pin.x <= 262 && pin.y >= 0 && pin.y <= 530);
---

<svg class="pt-outline" viewBox="0 0 262 530" role="presentation" aria-hidden="true">
	<path class="pt-outline__land" d={OUTLINE}></path>
	{pins.map((pin) => <circle class="pt-outline__pin" cx={pin.x} cy={pin.y} r="8" />)}
</svg>

<style>
	.pt-outline {
		width: 100%;
		max-width: 9rem;
		height: auto;
	}

	.pt-outline__land {
		fill: var(--sr-bg-well);
		stroke: var(--sr-border-strong);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.pt-outline__pin {
		fill: var(--sr-map-pin-fill);
		stroke: var(--sr-map-pin-stroke);
		stroke-width: 2;
	}
</style>
