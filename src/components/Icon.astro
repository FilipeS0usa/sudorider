---
/**
 * Hand-authored inline SVG. No icon font, no sprite sheet, no library
 * (design-system §5.6). Every icon is decorative and always sits beside a
 * visible text label.
 */
interface Props {
	name: 'youtube' | 'email';
	size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
	class="icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'youtube' && (
			<>
				<rect
					x="2"
					y="5"
					width="20"
					height="14"
					rx="4.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
				/>
				<path d="M10.2 9.3v5.4l4.6-2.7z" fill="currentColor" />
			</>
		)
	}
	{
		name === 'email' && (
			<>
				<rect
					x="2.75"
					y="5"
					width="18.5"
					height="14"
					rx="2.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
				/>
				<path
					d="M3.75 7.5 12 13.3l8.25-5.8"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</>
		)
	}
</svg>

<style>
	.icon {
		flex: none;
		display: block;
	}
</style>
