---
/**
 * Video card (design-system §5.1).
 *
 * A closed <details> renders its contents at zero size, so `loading="lazy"` on
 * the iframe does not fetch: no YouTube JS, no cookies and no ~600KB player
 * until the reader deliberately opens a card. Nobody gets an eager iframe,
 * including the homepage.
 *
 * Deliberately no `autoplay=1`. The toggle is a real user gesture so it would
 * probably be permitted — which is exactly the problem, because on a motovlog
 * the audio starts with engine noise.
 */
import type { Video } from '../lib/types';
import { dataCurta, dataISO, paragrafoInicial, tituloLimpo } from './format';

interface Props {
	video: Video;
	/** grid = poster + title. stack = editorial row. hero = homepage fold. */
	variant?: 'grid' | 'stack' | 'hero';
	headingLevel?: 2 | 3;
	eyebrow?: string;
}

const { video, variant = 'grid', headingLevel = 3, eyebrow } = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
const titulo = tituloLimpo(video.title);
const short = video.isShort === true;
const excerto = variant === 'stack' ? paragrafoInicial(video.description) : '';
---

<article class:list={['v-card', `v-card--${variant}`]} data-format={short ? 'short' : 'wide'}>
	<details class="v-card__disclosure">
		<summary class="v-card__summary">
			{eyebrow && <span class="v-card__eyebrow">{eyebrow}</span>}

			<span class="v-card__well">
				{/* alt="" is deliberate: the title sits in the same <summary>, and a
				    duplicated alt makes screen readers announce the video twice. */}
				<img
					class="v-card__poster"
					src={video.thumbnail}
					width="480"
					height="360"
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span class="v-card__play" aria-hidden="true"></span>
				{short && <span class="tag v-card__badge">Short</span>}
			</span>

			<Heading class="v-card__title">{titulo}</Heading>
		</summary>

		<div class="v-card__player">
			<iframe
				src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
				title={`Vídeo: ${titulo}`}
				loading="lazy"
				allowfullscreen
				referrerpolicy="strict-origin-when-cross-origin"
				allow="accelerometer; encrypted-media; picture-in-picture; web-share"></iframe>
		</div>
	</details>

	{excerto && <p class="v-card__excerpt">{excerto}</p>}

	{/* Outside <details> so the date and the YouTube link stay reachable
	    whether the player is open or closed. */}
	<p class="v-card__meta">
		<time class="u-mono" datetime={dataISO(video.published)}>{dataCurta(video.published)}</time>
		<a href={video.url} rel="noopener">Ver no YouTube</a>
	</p>
</article>

<style>
	.v-card {
		display: flex;
		flex-direction: column;
		gap: var(--sr-space-3);
		padding: var(--sr-space-3);
		background: var(--sr-bg-surface);
		border: 1px solid var(--sr-border);
		border-radius: var(--sr-radius-md);
		box-shadow: var(--sr-shadow);
		transition: border-color var(--dur-1) var(--ease-out);
	}

	/* Cards change border and shadow only. A translated card nudges its
	   neighbours' perceived alignment and reads as jitter in a grid of
	   remote-loaded thumbnails. */
	.v-card:hover,
	.v-card:focus-within {
		border-color: var(--sr-border-strong);
	}

	.v-card__summary {
		display: grid;
		gap: var(--sr-space-3);
		cursor: pointer;
		list-style: none;
	}

	.v-card__summary::-webkit-details-marker {
		display: none;
	}

	.v-card__summary:focus-visible {
		outline: 2px solid var(--sr-focus);
		outline-offset: 2px;
		border-radius: var(--sr-radius-sm);
	}

	.v-card__eyebrow {
		font-family: var(--sr-font-mono);
		font-size: var(--sr-text-xs);
		letter-spacing: var(--sr-tracking-wide);
		text-transform: uppercase;
		color: var(--sr-fg-muted);
	}

	.v-card__well {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: var(--sr-radius-md);
		background: var(--sr-bg-well);
	}

	.v-card__poster {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-2) var(--ease-out);
	}

	.v-card:hover .v-card__poster {
		transform: scale(1.03);
	}

	.v-card__play {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		width: 3rem;
		height: 3rem;
		transform: translate(-50%, -50%);
		border-radius: 999px;
		background: rgb(20 22 26 / 0.72);
		box-shadow: inset 0 0 0 1px rgb(251 250 248 / 0.35);
	}

	.v-card__play::after {
		content: '';
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 54%;
		width: 0.85rem;
		height: 1rem;
		transform: translate(-50%, -50%);
		background: #fbfaf8;
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}

	.v-card__badge {
		position: absolute;
		inset-block-start: var(--sr-space-2);
		inset-inline-end: var(--sr-space-2);
		background: var(--sr-bg);
		color: var(--sr-fg);
	}

	.v-card__title {
		font-size: var(--sr-text-md);
		font-weight: 600;
		line-height: var(--sr-leading-snug);
		text-wrap: pretty;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.v-card__excerpt {
		font-size: var(--sr-text-sm);
		line-height: var(--sr-leading-relaxed);
		color: var(--sr-fg-muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.v-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--sr-space-2) var(--sr-space-4);
		margin-block-start: auto;
		font-size: var(--sr-text-xs);
		color: var(--sr-fg-muted);
	}

	.v-card__meta a {
		color: var(--sr-fg-muted);
		font-size: var(--sr-text-sm);
	}

	.v-card__meta a:hover {
		color: var(--sr-accent-text);
	}

	/* --- Shorts ----------------------------------------------------------- */

	/*
	 * hqdefault.jpg is always 480x360, so a Short arrives pillarboxed. Keeping
	 * the well at 16:9 preserves an identical card footprint across the grid;
	 * the centred 9:16 frame inside crops YouTube's baked-in bars away exactly
	 * — object-fit: cover keeps 0.5625/1.333 = 42.19% of the source width,
	 * which is the 202.5px the Short actually occupies.
	 */
	.v-card[data-format='short'] .v-card__well {
		display: grid;
		place-items: center;
	}

	.v-card[data-format='short'] .v-card__poster {
		aspect-ratio: 9 / 16;
		height: 100%;
		width: auto;
		object-fit: cover;
		border-radius: var(--sr-radius-sm);
		box-shadow: 0 0 0 1px var(--sr-border);
	}

	/* --- Open state ------------------------------------------------------- */

	.v-card__player {
		display: none;
	}

	.v-card__disclosure[open] .v-card__well {
		display: none;
	}

	.v-card__disclosure[open] .v-card__player {
		display: block;
	}

	.v-card__player iframe {
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
		border-radius: var(--sr-radius-md);
	}

	.v-card[data-format='short'] .v-card__player iframe {
		aspect-ratio: 9 / 16;
		max-width: 20rem;
		margin-inline: auto;
	}

	/* --- Hero variant ----------------------------------------------------- */

	.v-card--hero .v-card__title {
		font-size: var(--sr-text-xl);
	}

	/* --- Stack variant: editorial rows at --bp-md ------------------------- */

	.v-card--stack {
		padding: var(--sr-space-4);
	}

	.v-card--stack .v-card__title {
		font-size: var(--sr-text-xl);
	}

	@media (min-width: 52rem) {
		/* --bp-md */
		/*
		 * Two grids with identical tracks and gap, on the same content width,
		 * put the text column in the same place — so the excerpt and meta row
		 * line up under the title without needing subgrid.
		 */
		.v-card--stack {
			display: grid;
			grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
			column-gap: var(--sr-space-6);
			align-items: start;
			padding: var(--sr-space-4);
		}

		.v-card--stack > .v-card__disclosure {
			grid-column: 1 / -1;
		}

		.v-card--stack > .v-card__excerpt,
		.v-card--stack > .v-card__meta {
			grid-column: 2;
			margin-block-start: 0;
		}

		.v-card--stack .v-card__summary {
			grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
			grid-template-areas:
				'well eyebrow'
				'well title'
				'well .';
			column-gap: var(--sr-space-6);
			row-gap: var(--sr-space-2);
			align-content: start;
		}

		.v-card--stack .v-card__well {
			grid-area: well;
		}

		.v-card--stack .v-card__eyebrow {
			grid-area: eyebrow;
		}

		.v-card--stack .v-card__title {
			grid-area: title;
		}

		/* Opened, the row stops being two columns — the player and everything
		   under it run the full width. */
		.v-card--stack .v-card__disclosure[open] .v-card__summary {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'eyebrow'
				'title'
				'.';
		}

		.v-card--stack:has(.v-card__disclosure[open]) > .v-card__excerpt,
		.v-card--stack:has(.v-card__disclosure[open]) > .v-card__meta {
			grid-column: 1 / -1;
		}
	}
</style>
